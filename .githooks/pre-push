#!/bin/sh
# 可移植 pre-push 正本（家族模板 .github/scripts/templates/pre-push 同款 main 保护 + 可选台账闸）。
# 安装：git config core.hooksPath .githooks   （换机 / 重克隆后重跑一次）
# 台账闸（可选）：设置环境变量 GOVERNANCE_HOME 指向 ReSerendipity/.github 的本地克隆后生效；
# 未设置时打印提示并跳过——main 保护始终生效。逃生阀：SKIP_GOVERNANCE_HOOKS=1 git push ...
set -eu

if [ "${SKIP_GOVERNANCE_HOOKS:-0}" = "1" ]; then
  echo "pre-push: SKIP_GOVERNANCE_HOOKS=1，跳过治理检查" >&2
  exit 0
fi

# 1) main 不可删除、不可非快进（与家族 pre-push 模板逐字节同语义）
ZERO=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  [ "$remote_ref" = "refs/heads/main" ] || continue

  if [ "$local_sha" = "$ZERO" ]; then
    echo "pre-push: 禁止删除 main（remote=$remote_ref）" >&2
    exit 1
  fi

  if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "pre-push: 禁止非快进推送 main（remote $remote_sha 不是本地 $local_sha 的祖先）" >&2
    echo "pre-push: 先 git pull --rebase 合并远端；确需改写时显式 SKIP_GOVERNANCE_HOOKS=1" >&2
    exit 1
  fi
done

# 2) 家族台账闸（可选；无机器特定路径，经 GOVERNANCE_HOME 环境变量解析）
GOV="${GOVERNANCE_HOME:-}"
if [ -n "$GOV" ] && [ -f "$GOV/.github/scripts/check-ledger-append.ps1" ]; then
  pwsh -NoProfile -ExecutionPolicy Bypass \
    -File "$GOV/.github/scripts/check-ledger-append.ps1" \
    -Root "$(git rev-parse --show-toplevel)"
else
  echo "pre-push: 台账闸未启用（GOVERNANCE_HOME 未指向治理仓克隆；配置方法见 .githooks/README.md）" >&2
fi

exit 0
